# Public URL of the site (canonical URLs, sitemap, Open Graph images, JSON-LD).
# Leave unset on Vercel to use the project's production domain automatically;
# set it once the real domain (e.g. https://www.yves-oloume.com) points to this site.
NEXT_PUBLIC_SITE_URL=
# Set to "true" to block indexing (Vercel preview deployments are blocked automatically)
NEXT_PUBLIC_NOINDEX=false
